{
  "name": "@shilo/bronze-ui",
  "version": "0.2.7",
  "description": "A lightweight CSS-first theme for immersive interfaces, with native light and dark modes.",
  "type": "module",
  "license": "MIT",
  "author": "Shilo",
  "homepage": "https://shilo.github.io/bronze-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shilo/bronze-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Shilo/bronze-ui/issues"
  },
  "files": [
    "styles",
    "dist",
    "LICENSE",
    "NOTICE.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./style.css": {
      "types": "./styles/css.d.ts",
      "default": "./styles/style.css"
    },
    "./tokens.css": {
      "types": "./styles/css.d.ts",
      "default": "./styles/tokens.css"
    },
    "./components.css": {
      "types": "./styles/css.d.ts",
      "default": "./styles/components.css"
    },
    "./base.css": {
      "types": "./styles/css.d.ts",
      "default": "./styles/base.css"
    },
    "./svelte": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "svelte": "^5.57.2",
    "@lucide/svelte": "^1.61.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "@lucide/svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lucide/svelte": "1.61.0",
    "@sveltejs/package": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@playwright/test": "1.64.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5204 --strictPort",
    "package": "svelte-package -i src/lib -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run package && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5204 --strictPort",
    "test": "node tests/package.mjs",
    "e2e": "node tests/showcase.mjs",
    "prepack": "npm run package",
    "test:contracts": "node tests/contracts.mjs && node tests/materials.mjs && node tests/robustness.mjs && node tests/disabled.mjs"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.1"
  },
  "keywords": [
    "css",
    "theme",
    "dark-mode",
    "light-mode",
    "svelte",
    "game-ui",
    "design-system"
  ]
}
