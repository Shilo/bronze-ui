{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.svelte",
    "src/**/*.js",
    "showcase/**/*.svelte",
    "showcase/**/*.js"
  ]
}
